@page "/tasks"

@inject BlazorApp.Services.ITaskApiClient TaskClient
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Tasks · ScheduleGo</PageTitle>

<section class="tasks-page">
    <div class="tasks-heading">
        <div>
            <h1>Tasks</h1>
            <p class="page-intro">Sort, filter, and manage everything on your list.</p>
        </div>

        <RadzenButton Text="Add Task" Icon="add" Click="@OpenCreate" Class="primary-action" />
    </div>

    @if (loadError is not null)
    {
        <div class="status-message error" role="alert">@loadError</div>
    }
    else
    {
        <div class="tasks-card">
            <RadzenDataGrid @ref="tasksGrid" Data="@tasks" TItem="TodoItemDto" IsLoading="@isLoading"
                            AllowFiltering="true" FilterMode="FilterMode.Simple"
                            AllowSorting="true" AllowPaging="true" AllowColumnResize="true"
                            PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 20 })"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            EmptyText="You don't have any tasks yet." Class="tasks-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="TodoItemDto" Title="ID" Width="125px" Filterable="false">
                        <Template Context="task"><code>@ShortId(task.Id)</code></Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="Title" Title="Title" MinWidth="180px">
                        <Template Context="task">
                            <strong class="@(task.IsCompleted ? "is-complete" : null)">@task.Title</strong>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="Description" Title="Description" MinWidth="220px">
                        <Template Context="task">
                            <span class="description" title="@task.Description">
                                @(string.IsNullOrWhiteSpace(task.Description) ? "—" : task.Description)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="DueAt" Title="Due date"
                                          FormatString="{0:MMM d, yyyy}" Width="170px" />

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="EventTitle" Title="Event" MinWidth="170px">
                        <Template Context="task">@(task.EventTitle ?? "—")</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="Priority" Title="Priority" Width="130px">
                        <Template Context="task">
                            <RadzenBadge Text="@task.Priority.ToString()"
                                         BadgeStyle="@PriorityBadgeStyle(task.Priority)" IsPill="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Property="IsCompleted" Title="Completed"
                                          Width="130px" Filterable="false">
                        <Template Context="task">
                            <RadzenSwitch TValue="bool" Value="@task.IsCompleted"
                                          Change="@((bool value) => SetCompleted(task, value))"
                                          aria-label="@($"Toggle completion for {task.Title}")" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TodoItemDto" Title="Actions" Width="120px"
                                          Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="task">
                            <div class="grid-actions">
                                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Medium" Click="@(() => OpenEdit(task))"
                                              aria-label="@($"Edit {task.Title}")" />
                                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Medium" Click="@(() => ConfirmDeleteTask(task))"
                                              aria-label="@($"Delete {task.Title}")" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</section>

@if (editorMode is not null)
{
    <div class="modal-layer" role="presentation" @onclick="CloseEditor">
        <section class="event-modal" role="dialog" aria-modal="true" aria-labelledby="task-modal-title" @onclick:stopPropagation>
            <header>
                <h2 id="task-modal-title">@(editorMode == TaskEditorMode.Create ? "New Task" : "Edit Task")</h2>
                <p>@(editorMode == TaskEditorMode.Create ? "Fill in the details for your new task." : "Update the details below.")</p>
            </header>

            @if (editorError is not null)
            {
                <div class="modal-error" role="alert">@editorError</div>
            }

            <EditForm Model="@editor" OnValidSubmit="@SaveEditor">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="task-title">Title</label>
                    <RadzenTextBox Name="Title" @bind-Value="@editor.Title"
                                   Placeholder="e.g. Prepare meeting notes" Style="width: 100%" />
                    <ValidationMessage For="@(() => editor.Title)" />
                </div>

                <div class="field">
                    <label for="task-description">Description</label>
                    <RadzenTextArea Name="Description" @bind-Value="@editor.Description" Rows="4"
                                    Placeholder="Brief description (optional)" Style="width: 100%" />
                    <ValidationMessage For="@(() => editor.Description)" />
                </div>

                <div class="date-toggle-row">
                    <div class="field">
                        <label for="task-due-date">Due Date</label>
                        <RadzenDatePicker TValue="DateTime?" Name="DueAt" @bind-Value="@editor.DueAt"
                                          ShowTime="true" DateFormat="MMM d, yyyy h:mm tt" Style="width: 100%" />
                        <ValidationMessage For="@(() => editor.DueAt)" />
                    </div>

                    <div class="field">
                        <label for="task-priority">Priority</label>
                        <RadzenDropDown TValue="TaskPriority" Name="Priority" @bind-Value="@editor.Priority"
                                        Data="@priorityOptions" Style="width: 100%" />
                    </div>
                </div>

                <div class="field">
                    <label for="task-event">Related event</label>
                    <RadzenDropDown TValue="Guid?" Name="EventId" @bind-Value="@editor.EventId"
                                    Data="@events" TextProperty="Title" ValueProperty="Id"
                                    AllowClear="true" Placeholder="No related event" Style="width: 100%" />
                </div>

                <div class="modal-actions">
                    <RadzenButton Text="Cancel" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Outlined" Click="@CloseEditor" Disabled="@isSaving" />
                    <RadzenButton Text="@(editorMode == TaskEditorMode.Create ? "Add Task" : "Save Changes")"
                                  Icon="save" ButtonType="ButtonType.Submit" Disabled="@isSaving" IsBusy="@isSaving" />
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private readonly TaskPriority[] priorityOptions = Enum.GetValues<TaskPriority>();
    private RadzenDataGrid<TodoItemDto>? tasksGrid;
    private List<TodoItemDto> tasks = [];
    private List<Event> events = [];
    private bool isLoading = true;
    private string? loadError;
    private TaskEditorMode? editorMode;
    private TodoItemDto? editingTask;
    private SaveTodoItemRequest editor = new();
    private string? editorError;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var taskResult = await TaskClient.GetAllAsync();
            tasks = taskResult.ToList();
            events = await Http.GetFromJsonAsync<List<Event>>("api/Events") ?? [];
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            loadError = "The tasks and events could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetCompleted(TodoItemDto task, bool completed)
    {
        var previousValue = task.IsCompleted;
        try
        {
            task.IsCompleted = completed;
            await TaskClient.SetCompletedAsync(task.Id, completed);
            await ReloadGridAsync();
            NotificationService.Notify(NotificationSeverity.Success,
                completed ? "Task completed" : "Task reopened", task.Title, 2500);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            task.IsCompleted = previousValue;
            NotificationService.Notify(NotificationSeverity.Error, "Update failed", "The task could not be updated.");
        }
    }

    private void OpenCreate()
    {
        editingTask = null;
        editor = new SaveTodoItemRequest();
        editorMode = TaskEditorMode.Create;
        editorError = null;
    }

    private void OpenEdit(TodoItemDto task)
    {
        editingTask = task;
        editor = new SaveTodoItemRequest
        {
            Title = task.Title,
            Description = task.Description,
            DueAt = task.DueAt,
            Priority = task.Priority,
            EventId = task.EventId
        };
        editorMode = TaskEditorMode.Edit;
        editorError = null;
    }

    private void CloseEditor()
    {
        if (!isSaving)
        {
            editorMode = null;
            editingTask = null;
            editorError = null;
        }
    }

    private async Task SaveEditor()
    {
        if (editorMode is null || (editorMode == TaskEditorMode.Edit && editingTask is null)) return;

        var savedMode = editorMode.Value;
        isSaving = true;
        editorError = null;

        try
        {
            if (savedMode == TaskEditorMode.Create)
            {
                var created = await TaskClient.CreateAsync(editor);
                tasks.Insert(0, created);
            }
            else
            {
                var updated = await TaskClient.UpdateAsync(editingTask!.Id, editor);
                editingTask.Title = updated.Title;
                editingTask.Description = updated.Description;
                editingTask.DueAt = updated.DueAt;
                editingTask.Priority = updated.Priority;
                editingTask.IsCompleted = updated.IsCompleted;
                editingTask.EventId = updated.EventId;
                editingTask.EventTitle = updated.EventTitle;
                editingTask.EventStart = updated.EventStart;
            }

            await ReloadGridAsync();
            editorMode = null;
            editingTask = null;
            NotificationService.Notify(NotificationSeverity.Success,
                savedMode == TaskEditorMode.Create ? "Task added" : "Task updated",
                "Your changes have been saved.", 3000);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            editorError = "The task could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmDeleteTask(TodoItemDto task)
    {
        var confirmed = await DialogService.Confirm($"'{task.Title}' will be permanently removed.", "Delete task?",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed is not true) return;

        try
        {
            await TaskClient.DeleteAsync(task.Id);
            tasks.Remove(task);
            await ReloadGridAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Task deleted", task.Title, 3000);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", "The task could not be deleted.");
        }
    }

    private static BadgeStyle PriorityBadgeStyle(TaskPriority priority) => priority switch
    {
        TaskPriority.High => BadgeStyle.Danger,
        TaskPriority.Low => BadgeStyle.Success,
        _ => BadgeStyle.Info
    };

    private async Task ReloadGridAsync()
    {
        if (tasksGrid is not null)
        {
            await tasksGrid.Reload();
        }
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();

    private enum TaskEditorMode { Create, Edit }
}
