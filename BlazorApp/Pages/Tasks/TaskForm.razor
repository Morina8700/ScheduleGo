<EditForm Model="@Model"
          OnValidSubmit="@HandleValidSubmit">

    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label for="task-title" class="form-label">
            Title
        </label>

        <InputText id="task-title"
                   class="form-control"
                   @bind-Value="Model.Title" />

        <ValidationMessage For="@(() => Model.Title)"
                           class="text-danger" />
    </div>

    <div class="mb-3">
        <label for="task-description" class="form-label">
            Description
        </label>

        <InputTextArea id="task-description"
                       class="form-control"
                       rows="4"
                       @bind-Value="Model.Description" />

        <ValidationMessage For="@(() => Model.Description)"
                           class="text-danger" />
    </div>

    <div class="mb-3">
        <label for="task-due-date" class="form-label">
            Due date
        </label>

        <InputDate id="task-due-date"
                   class="form-control"
                   Type="InputDateType.DateTimeLocal"
                   @bind-Value="Model.DueAt" />

        <ValidationMessage For="@(() => Model.DueAt)"
                           class="text-danger" />
    </div>

    <div class="mb-4">
        <label for="task-priority" class="form-label">
            Priority
        </label>

        <InputSelect id="task-priority"
                     class="form-select"
                     @bind-Value="Model.Priority">

            <option value="@TaskPriority.Low">Low</option>
            <option value="@TaskPriority.Normal">Normal</option>
            <option value="@TaskPriority.High">High</option>
        </InputSelect>

        <ValidationMessage For="@(() => Model.Priority)"
                           class="text-danger" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary"
                type="submit"
                disabled="@IsSaving">

            @if (IsSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"
                      aria-hidden="true"></span>

                <span>Saving...</span>
            }
            else
            {
                <span>@SubmitText</span>
            }
        </button>

        <a class="btn btn-outline-secondary"
           href="/tasks">
            Cancel
        </a>
    </div>
</EditForm>

@code {
    [Parameter]
    [EditorRequired]
    public SaveTodoItemRequest Model { get; set; } = default!;

    [Parameter]
    public string SubmitText { get; set; } = "Save task";

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public EventCallback<SaveTodoItemRequest> OnSubmit { get; set; }

    private Task HandleValidSubmit()
    {
        return OnSubmit.InvokeAsync(Model);
    }
}