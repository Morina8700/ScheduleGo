@page "/Events"

@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Events · ScheduleGo</PageTitle>

<section class="events-page">
    <div class="events-heading">
        <div>
            <h1>Events</h1>
            <p class="page-intro">Switch between a searchable list and your calendar.</p>
        </div>

        <div class="heading-actions">
            <div class="view-switcher" aria-label="Event view">
                <RadzenButton Text="List" Icon="view_list"
                              ButtonStyle="@(activeView == EventView.List ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Variant="@(activeView == EventView.List ? Variant.Filled : Variant.Outlined)"
                              Click="@(() => activeView = EventView.List)" />
                <RadzenButton Text="Calendar" Icon="calendar_month"
                              ButtonStyle="@(activeView == EventView.Calendar ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Variant="@(activeView == EventView.Calendar ? Variant.Filled : Variant.Outlined)"
                              Click="@(() => activeView = EventView.Calendar)" />
            </div>

            <RadzenButton Text="Add Event" Icon="add" Click="@OpenCreate" Class="primary-action" />
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="status-message error" role="alert">
            @loadError
            <RadzenButton Text="Try again" Icon="refresh" Variant="Variant.Text" Click="@LoadEvents" />
        </div>
    }
    else if (events is null)
    {
        <div class="status-message" role="status">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <span>Loading events…</span>
        </div>
    }
    else if (activeView == EventView.List)
    {
        <div class="events-card">
            <RadzenDataGrid Data="@events" TItem="Event"
                            AllowFiltering="true" FilterMode="FilterMode.Simple"
                            AllowSorting="true" AllowPaging="true" AllowColumnResize="true"
                            PageSize="10" PageSizeOptions="@(new int[] { 5, 10, 20 })"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            EmptyText="You don't have any events yet." Class="events-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="Event" Title="ID" Width="125px" Filterable="false">
                        <Template Context="evt"><code>@ShortId(evt.Id)</code></Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Event" Property="Title" Title="Title" MinWidth="190px">
                        <Template Context="evt"><strong>@evt.Title</strong></Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Event" Property="Description" Title="Description" MinWidth="250px">
                        <Template Context="evt">
                            <span class="description" title="@evt.Description">
                                @(string.IsNullOrWhiteSpace(evt.Description) ? "—" : evt.Description)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Event" Property="Start" Title="Date"
                                          FormatString="{0:MMM d, yyyy}" Width="170px" />

                    <RadzenDataGridColumn TItem="Event" Property="AllDay" Title="All day"
                                          Width="120px" Filterable="false">
                        <Template Context="evt">
                            <RadzenSwitch TValue="bool" Value="@evt.AllDay"
                                          Change="@((bool value) => SetAllDay(evt, value))"
                                          aria-label="@($"Toggle all day for {evt.Title}")" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Event" Title="Actions" Width="120px"
                                          Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="evt">
                            <div class="grid-actions">
                                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                                              Click="@(() => OpenEdit(evt))" aria-label="@($"Edit {evt.Title}")" />
                                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger"
                                              Click="@(() => ConfirmDeleteEvent(evt))" aria-label="@($"Delete {evt.Title}")" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
    else
    {
        <div class="scheduler-card">
            <RadzenScheduler Data="@events" TItem="Event"
                             StartProperty="Start" EndProperty="End" TextProperty="Title"
                             AppointmentSelect="@OnAppointmentSelect" SelectedIndex="0"
                             Style="height: 680px;">
                <RadzenMonthView />
                <RadzenWeekView />
                <RadzenDayView />
                <RadzenAgendaView />
            </RadzenScheduler>
        </div>
    }
</section>

@if (editorMode is not null)
{
    <div class="modal-layer" role="presentation" @onclick="CloseEditor">
        <section class="event-modal" role="dialog" aria-modal="true" aria-labelledby="event-modal-title" @onclick:stopPropagation>
            <header>
                <h2 id="event-modal-title">@(editorMode == EditorMode.Create ? "New Event" : "Edit Event")</h2>
                <p>@(editorMode == EditorMode.Create ? "Fill in the details for your new event." : "Update the details below.")</p>
            </header>

            @if (editorError is not null)
            {
                <div class="modal-error" role="alert">@editorError</div>
            }

            <div class="field">
                <label for="event-title">Title</label>
                <RadzenTextBox Name="Title" @bind-Value="@editor.Title"
                               Placeholder="e.g. Team kickoff" Style="width: 100%" />
            </div>

            <div class="field">
                <label for="event-description">Description</label>
                <RadzenTextArea Name="Description" @bind-Value="@editor.Description" Rows="4"
                                Placeholder="Brief description (optional)" Style="width: 100%" />
            </div>

            <div class="date-toggle-row">
                <div class="field">
                    <label for="event-start">Date</label>
                    <RadzenDatePicker TValue="DateTime" Name="Start" @bind-Value="@editor.Start"
                                      DateFormat="MMM d, yyyy" Style="width: 100%" />
                </div>
                <div class="field toggle-field">
                    <label>All Day</label>
                    <RadzenSwitch TValue="bool" @bind-Value="@editor.AllDay" />
                </div>
            </div>

            <div class="modal-actions">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
                              Click="@CloseEditor" Disabled="@isSaving" />
                <RadzenButton Text="@(editorMode == EditorMode.Create ? "Add Event" : "Save Changes")"
                              Icon="save" Click="@SaveEditor" Disabled="@isSaving" IsBusy="@isSaving" />
            </div>
        </section>
    </div>
}

@code {
    private List<Event>? events;
    private string? loadError;
    private EventDto editor = NewEditor();
    private EditorMode? editorMode;
    private EventView activeView = EventView.List;
    private Guid editingId;
    private string? editorError;
    private bool isSaving;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        try
        {
            loadError = null;
            events = await Http.GetFromJsonAsync<List<Event>>("api/Events") ?? [];
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load events: {ex}");
            loadError = "The event list could not be loaded. Make sure the Web API is running, then try again.";
        }
    }

    private void OpenCreate()
    {
        editor = NewEditor();
        editorMode = EditorMode.Create;
        editorError = null;
    }

    private void OpenEdit(Event evt)
    {
        editingId = evt.Id;
        editor = new EventDto
        {
            Title = evt.Title,
            Description = evt.Description,
            Start = evt.Start,
            End = evt.End,
            AllDay = evt.AllDay
        };
        editorMode = EditorMode.Edit;
        editorError = null;
    }

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Event> args)
    {
        if (args.Data is not null)
        {
            OpenEdit(args.Data);
        }
    }

    private void CloseEditor()
    {
        if (!isSaving)
        {
            editorMode = null;
            editorError = null;
        }
    }

    private async Task SaveEditor()
    {
        if (editorMode is null || string.IsNullOrWhiteSpace(editor.Title))
        {
            editorError = "A title is required.";
            return;
        }

        var savedMode = editorMode.Value;
        isSaving = true;
        editorError = null;

        try
        {
            editor.End = editor.Start.Date.AddDays(1);
            var response = savedMode == EditorMode.Create
                ? await Http.PostAsJsonAsync("api/Events", editor)
                : await Http.PutAsJsonAsync($"api/Events/{editingId}", editor);

            if (!response.IsSuccessStatusCode)
            {
                editorError = "The event could not be saved. Please check the details and try again.";
                return;
            }

            editorMode = null;
            await LoadEvents();
            NotificationService.Notify(NotificationSeverity.Success,
                savedMode == EditorMode.Create ? "Event added" : "Event updated",
                "Your changes have been saved.", 3000);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            editorError = "The event could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SetAllDay(Event evt, bool allDay)
    {
        var previousValue = evt.AllDay;
        evt.AllDay = allDay;
        var request = new EventDto
        {
            Title = evt.Title,
            Description = evt.Description,
            Start = evt.Start,
            End = evt.End,
            AllDay = allDay
        };

        try
        {
            var response = await Http.PutAsJsonAsync($"api/Events/{evt.Id}", request);
            response.EnsureSuccessStatusCode();
            NotificationService.Notify(NotificationSeverity.Success, "Event updated", evt.Title, 2500);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            evt.AllDay = previousValue;
            NotificationService.Notify(NotificationSeverity.Error, "Update failed", "The event could not be updated.");
        }
    }

    private async Task ConfirmDeleteEvent(Event evt)
    {
        var confirmed = await DialogService.Confirm($"'{evt.Title}' will be permanently removed.", "Delete event?",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed is not true) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Events/{evt.Id}");
            response.EnsureSuccessStatusCode();
            events?.Remove(evt);
            NotificationService.Notify(NotificationSeverity.Success, "Event deleted", evt.Title, 3000);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", "The event could not be deleted.");
        }
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();

    private static EventDto NewEditor()
    {
        var start = DateTime.Today;
        return new EventDto { Start = start, End = start.AddDays(1) };
    }

    private enum EditorMode { Create, Edit }
    private enum EventView { List, Calendar }
}
