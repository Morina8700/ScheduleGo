@page "/Events"
@inject HttpClient Http

<PageTitle>Events · ScheduleGo</PageTitle>

<section class="events-page">
    <div class="events-heading">
        <h1>Event List</h1>

        <button class="primary-action" type="button" @onclick="OpenCreate">
            <span aria-hidden="true">+</span>
            Add Event
        </button>
    </div>

    @if (loadError is not null)
    {
        <div class="status-message error" role="alert">@loadError</div>
    }
    else if (events is null)
    {
        <div class="status-message" role="status">Loading events…</div>
    }
    else
    {
        <div class="events-card">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Date</th>
                            <th>All Day</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in events)
                        {
                            <tr>
                                <td><code>@ShortId(evt.Id)</code></td>
                                <td><strong>@evt.Title</strong></td>
                                <td><span class="description" title="@evt.Description">@evt.Description</span></td>
                                <td class="date-cell">@evt.Start.ToString("MMM d, yyyy")</td>
                                <td>
                                    <button class="event-switch @(evt.AllDay ? "is-on" : null)"
                                            type="button"
                                            role="switch"
                                            aria-checked="@evt.AllDay"
                                            aria-label="Toggle all day for @evt.Title"
                                            @onclick="() => ToggleAllDay(evt)">
                                        <span></span>
                                    </button>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <button type="button" aria-label="Edit @evt.Title" @onclick="() => OpenEdit(evt)">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 6.5 17.5 10.5M4 20l4.2-1 10.4-10.4a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z" /></svg>
                                        </button>
                                        <button type="button" aria-label="Delete @evt.Title" @onclick="() => OpenDelete(evt)">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5" /></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer>@events.Count @(events.Count == 1 ? "event" : "events")</footer>
        </div>
    }
</section>

@if (editorMode is not null)
{
    <div class="modal-layer" role="presentation" @onclick="CloseEditor">
        <section class="event-modal" role="dialog" aria-modal="true" aria-labelledby="event-modal-title" @onclick:stopPropagation>
            <header>
                <h2 id="event-modal-title">@(editorMode == EditorMode.Create ? "New Event" : "Edit Event")</h2>
                <p>@(editorMode == EditorMode.Create ? "Fill in the details for your new event." : "Update the details below.")</p>
            </header>

            @if (editorError is not null)
            {
                <div class="modal-error" role="alert">@editorError</div>
            }

            <div class="field">
                <label for="event-title">Title</label>
                <input id="event-title" placeholder="e.g. Team kickoff" @bind="editor.Title" />
            </div>

            <div class="field">
                <label for="event-description">Description</label>
                <textarea id="event-description" rows="4" placeholder="Brief description (optional)" @bind="editor.Description"></textarea>
            </div>

            <div class="date-toggle-row">
                <div class="field">
                    <label for="event-start">Date</label>
                    <input id="event-start" type="date" @bind="editor.Start" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="field toggle-field">
                    <label>All Day</label>
                    <button class="event-switch @(editor.AllDay ? "is-on" : null)"
                        type="button" role="switch" aria-checked="@editor.AllDay"
                        @onclick="() => editor.AllDay = !editor.AllDay"><span></span></button>
                </div>
            </div>

            <div class="modal-actions">
                <button class="secondary-action" type="button" @onclick="CloseEditor">Cancel</button>
                <button class="primary-action" type="button" disabled="@isSaving" @onclick="SaveEditor">
                    @(isSaving ? "Saving…" : editorMode == EditorMode.Create ? "Add Event" : "Save Changes")
                </button>
            </div>
        </section>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="modal-layer" role="presentation" @onclick="CloseDelete">
        <section class="delete-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <div class="delete-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5" /></svg>
            </div>
            <h2 id="delete-title">Delete event?</h2>
            <p><strong>@pendingDelete.Title</strong> will be permanently removed.</p>
            @if (deleteError is not null)
            {
                <div class="modal-error" role="alert">@deleteError</div>
            }
            <div class="modal-actions">
                <button class="secondary-action" type="button" @onclick="CloseDelete">Cancel</button>
                <button class="danger-action" type="button" disabled="@isDeleting" @onclick="DeleteEvent">
                    @(isDeleting ? "Deleting…" : "Delete")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private List<Event>? events;
    private string? loadError;
    private EventDto editor = NewEditor();
    private EditorMode? editorMode;
    private Guid editingId;
    private string? editorError;
    private bool isSaving;
    private Event? pendingDelete;
    private string? deleteError;
    private bool isDeleting;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        try
        {
            loadError = null;
            events = await Http.GetFromJsonAsync<List<Event>>("api/Events") ?? [];
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load events: {ex}");
            loadError = "The event list could not be loaded. Make sure the Web API is running, then refresh the page.";
        }
    }

    private void OpenCreate()
    {
        editor = NewEditor();
        editorMode = EditorMode.Create;
        editorError = null;
    }

    private void OpenEdit(Event evt)
    {
        editingId = evt.Id;
        editor = new EventDto
        {
            Title = evt.Title,
            Description = evt.Description,
            Start = evt.Start,
            End = evt.End,
            AllDay = evt.AllDay
        };
        editorMode = EditorMode.Edit;
        editorError = null;
    }

    private void CloseEditor()
    {
        if (!isSaving)
        {
            editorMode = null;
            editorError = null;
        }
    }

    private async Task SaveEditor()
    {
        if (string.IsNullOrWhiteSpace(editor.Title))
        {
            editorError = "A title is required.";
            return;
        }

        isSaving = true;
        editorError = null;

        try
        {
            editor.End = editor.Start.Date.AddDays(1);
            var response = editorMode == EditorMode.Create
                ? await Http.PostAsJsonAsync("api/Events", editor)
                : await Http.PutAsJsonAsync($"api/Events/{editingId}", editor);

            if (!response.IsSuccessStatusCode)
            {
                editorError = "The event could not be saved. Please check the details and try again.";
                return;
            }

            editorMode = null;
            await LoadEvents();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            editorError = "The event could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleAllDay(Event evt)
    {
        var request = new EventDto
        {
            Title = evt.Title,
            Description = evt.Description,
            Start = evt.Start,
            End = evt.End,
            AllDay = !evt.AllDay
        };

        try
        {
            var response = await Http.PutAsJsonAsync($"api/Events/{evt.Id}", request);
            response.EnsureSuccessStatusCode();
            evt.AllDay = request.AllDay;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            loadError = "The event could not be updated.";
        }
    }

    private void OpenDelete(Event evt)
    {
        pendingDelete = evt;
        deleteError = null;
    }

    private void CloseDelete()
    {
        if (!isDeleting)
        {
            pendingDelete = null;
            deleteError = null;
        }
    }

    private async Task DeleteEvent()
    {
        if (pendingDelete is null)
        {
            return;
        }

        isDeleting = true;
        deleteError = null;

        try
        {
            var response = await Http.DeleteAsync($"api/Events/{pendingDelete.Id}");
            response.EnsureSuccessStatusCode();
            events?.Remove(pendingDelete);
            pendingDelete = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            deleteError = "The event could not be deleted. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();

    private static EventDto NewEditor()
    {
        var start = DateTime.Today;
        return new EventDto { Start = start, End = start.AddDays(1) };
    }

    private enum EditorMode { Create, Edit }
}
